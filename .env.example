# ============================================================
# InfraWatch AI — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# Database Configuration
DB_USERNAME=
DB_PASSWORD=

# Security — Generate a strong random secret (min 64 chars recommended for HS512)
# Example command: openssl rand -hex 64
JWT_SECRET=

# Service Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000

# Service URLs (used by docker-compose)
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/infrawatchdb?useSSL=false&allowPublicKeyRetrieval=true
ML_SERVICE_URL=http://ml-service:8000
