# ============================================================
# InfraWatch AI — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# Database Configuration
DB_USERNAME=root
DB_PASSWORD=change-me

# Security — Generate a strong random secret (min 64 chars recommended for HS512)
# Example command: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret

# Service Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_PORT=8000

# Service URLs (used by docker-compose)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.MySQLDialect
ML_SERVICE_URL=
